# ===========================================
# CONTROL MISSION - Configuración
# ===========================================

# Puerto del servidor backend
PORT=4000

# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================
# Obtén tu token de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# IDs de usuarios autorizados (separados por coma)
TELEGRAM_AUTHORIZED_USERS=

# Nombre del bot (opcional, para logs)
TELEGRAM_BOT_NAME=

# ===========================================
# OPENAI WHISPER - Transcripción de Audio
# ===========================================
# Necesario para comandos de voz
OPENAI_API_KEY=

# ===========================================
# SEGURIDAD
# ===========================================
API_SECRET_KEY=cambia-esta-clave-secreta-muy-segura-12345

# ===========================================
# LOGS
# ===========================================
LOG_LEVEL=info
LOG_FILE=logs/control-mission.log

# ===========================================
# AGENTES
# ===========================================
MAX_CONCURRENT_TASKS=5
AGENT_TIMEOUT_MINUTES=30

# ===========================================
# BASE DE DATOS (lowdb - archivo JSON)
# ===========================================
DB_FILE=config/db.json
